# Copy to deploy/.env; generate three different random hex secrets (32 bytes each).
POSTGRES_PASSWORD=change_me_database_password
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
APP_BIND=127.0.0.1
APP_PORT=8080
WEB_ORIGIN=http://localhost:8080
LLM_PROVIDER=local
LLM_BASE_URL=http://local-llm:8081/v1
LLM_MODEL=reviewlens-local
LOCAL_LLM_BASE_URL=http://local-llm:8081/v1
LOCAL_LLM_MODEL_FILE=/app/local_models/model.gguf
LOCAL_LLM_THREADS=4
LLM_MODEL_VERSION=unverified
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=1
LLM_TIMEOUT_MS=300000
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=2c4055b12046f11709e9df2c122e59ffbdc2f900
EMBEDDING_LOCAL_ONLY=true
