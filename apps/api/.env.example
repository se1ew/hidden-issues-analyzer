NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://hia:hia_password@localhost:5432/hia_db?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long_xxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long_xxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OpenRouter: save a personal API key and choose a model in Profile.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_TIMEOUT_MS=60000
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=1
LLM_RETRIES=2
LLM_RETRY_DELAY_MS=500
LLM_MAX_RETRY_DELAY_MS=5000
LLM_RESPONSE_FORMAT=json_object
LLM_CLOUD_DELAY_MS=4000
ANALYSIS_QUEUE_NAME=analysis-runs-v1
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_HEARTBEAT_MS=1000
ANALYSIS_LEASE_MS=30000
ANALYSIS_DISPATCH_MS=2000

# Optional installation key; the app starts before account keys are saved.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=main
EMBEDDING_BATCH_SIZE=16

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Immutable model revision/digest; unverified disables the extraction cache.
LLM_MODEL_VERSION=unverified
# Optional production SPA directory, relative to the API working directory.
# WEB_DIST_DIR=../web/dist
# EMBEDDING_CACHE_DIR=../../.cache/portable-models
EMBEDDING_LOCAL_ONLY=false
