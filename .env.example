# ===== API =====
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL via docker-compose)
DATABASE_URL=postgresql://hia:hia_password@localhost:5432/hia_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Provider: local or openrouter. Local runtime is installed separately.
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_TIMEOUT_MS=60000
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=1
LLM_RETRIES=2
LLM_RETRY_DELAY_MS=500
LLM_MAX_RETRY_DELAY_MS=5000
LLM_RESPONSE_FORMAT=json_object
LLM_CLOUD_DELAY_MS=4000
ANALYSIS_QUEUE_NAME=analysis-runs-v1
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_HEARTBEAT_MS=1000
ANALYSIS_LEASE_MS=30000
ANALYSIS_DISPATCH_MS=2000

# Required only for LLM_PROVIDER=openrouter; also change LLM_BASE_URL and LLM_MODEL.
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding model (через @xenova/transformers, ONNX)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=main
EMBEDDING_BATCH_SIZE=16

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ===== WEB =====
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# Immutable model revision/digest; unverified disables the extraction cache.
LLM_MODEL_VERSION=unverified
